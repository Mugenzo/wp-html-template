{
  "private": true,
  "type": "module",
  "scripts": {
    "dev:html": "vite",
    "build:html": "vite build --mode html",
    "dev:wp": "vite build --watch --mode wp-dev",
    "build:wp": "vite build --mode wp",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"resources/sass/**/*.{css,scss}\"",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "check": "npm run lint && npm run build:html && node scripts/check-assets.mjs && npm run build:wp && node scripts/check-wp.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "lightgallery": "^2.9.0",
    "swiper": "^11.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "posthtml": "^0.16.6",
    "posthtml-extend": "^0.6.5",
    "posthtml-include": "^2.0.1",
    "sass": "^1.86.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^6.3.5",
    "vite-plugin-full-reload": "^1.2.0",
    "vite-plugin-static-copy": "^2.3.1"
  }
}
