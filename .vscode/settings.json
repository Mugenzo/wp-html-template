{
  "editor.codeActionsOnSave": {
    "source.fixUnusedImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": ["javascript"],
  "eslint.useFlatConfig": true,
  "stylelint.enable": true,
  "stylelint.validate": ["css", "scss"],
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false
}
